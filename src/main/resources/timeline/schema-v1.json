{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-watch-spaces.local/schemas/timeline-v1.json",
  "title": "AI Watch Spaces timeline document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "titleId",
    "durationMs",
    "events"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "titleId": {
      "type": "string",
      "format": "uuid"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "eventBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventKey",
        "type",
        "startMs",
        "payload"
      ],
      "properties": {
        "eventKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "enum": [
            "SCENE",
            "CHARACTER",
            "TRIVIA",
            "GLOSSARY",
            "VARIATION_POINT"
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "payload": {
          "type": "object"
        },
        "options": {
          "type": "array"
        }
      }
    },
    "scenePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "summary"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "characterPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "characterName",
        "description"
      ],
      "properties": {
        "characterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "triviaPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "glossaryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "term",
        "definition"
      ],
      "properties": {
        "term": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "subtitleTextOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "locale",
        "textValue",
        "approved",
        "default",
        "sortOrder"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "textValue": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "approved": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "subtitleTrackSwapOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "locale",
        "subtitleTrackId",
        "approved",
        "default",
        "sortOrder"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "locale": {
          "$ref": "#/$defs/locale"
        },
        "subtitleTrackId": {
          "type": "string",
          "format": "uuid"
        },
        "approved": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "assetOption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "label",
        "assetUri",
        "approved",
        "default",
        "sortOrder"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "assetUri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "approved": {
          "type": "boolean"
        },
        "default": {
          "type": "boolean"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "variationOptions": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/subtitleTextOption"
          },
          {
            "$ref": "#/$defs/subtitleTrackSwapOption"
          },
          {
            "$ref": "#/$defs/assetOption"
          }
        ]
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "approved": {
                "const": true
              }
            },
            "required": [
              "approved"
            ]
          },
          "minContains": 2
        },
        {
          "contains": {
            "properties": {
              "approved": {
                "const": true
              },
              "default": {
                "const": true
              }
            },
            "required": [
              "approved",
              "default"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "variationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variationType"
      ],
      "properties": {
        "variationType": {
          "enum": [
            "SUBTITLE_TEXT",
            "SUBTITLE_TRACK_SWAP",
            "ASSET_SWAP",
            "NARRATIVE_BRANCH"
          ]
        },
        "cueKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "variationType": {
                "const": "SUBTITLE_TEXT"
              }
            },
            "required": [
              "variationType"
            ]
          },
          "then": {
            "required": [
              "cueKey"
            ]
          },
          "else": {
            "not": {
              "required": [
                "cueKey"
              ]
            }
          }
        }
      ]
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16,
      "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$"
    },
    "event": {
      "allOf": [
        {
          "$ref": "#/$defs/eventBase"
        },
        {
          "oneOf": [
            {
              "properties": {
                "type": {
                  "const": "SCENE"
                },
                "payload": {
                  "$ref": "#/$defs/scenePayload"
                }
              },
              "not": {
                "required": [
                  "options"
                ]
              }
            },
            {
              "properties": {
                "type": {
                  "const": "CHARACTER"
                },
                "payload": {
                  "$ref": "#/$defs/characterPayload"
                }
              },
              "not": {
                "required": [
                  "options"
                ]
              }
            },
            {
              "properties": {
                "type": {
                  "const": "TRIVIA"
                },
                "payload": {
                  "$ref": "#/$defs/triviaPayload"
                }
              },
              "not": {
                "required": [
                  "options"
                ]
              }
            },
            {
              "properties": {
                "type": {
                  "const": "GLOSSARY"
                },
                "payload": {
                  "$ref": "#/$defs/glossaryPayload"
                }
              },
              "not": {
                "required": [
                  "options"
                ]
              }
            },
            {
              "properties": {
                "type": {
                  "const": "VARIATION_POINT"
                },
                "payload": {
                  "$ref": "#/$defs/variationPayload"
                },
                "options": {
                  "$ref": "#/$defs/variationOptions"
                }
              },
              "required": [
                "options"
              ],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "payload": {
                        "properties": {
                          "variationType": {
                            "const": "SUBTITLE_TEXT"
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "options": {
                        "items": {
                          "$ref": "#/$defs/subtitleTextOption"
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "payload": {
                        "properties": {
                          "variationType": {
                            "const": "SUBTITLE_TRACK_SWAP"
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "options": {
                        "items": {
                          "$ref": "#/$defs/subtitleTrackSwapOption"
                        }
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "payload": {
                        "properties": {
                          "variationType": {
                            "enum": [
                              "ASSET_SWAP",
                              "NARRATIVE_BRANCH"
                            ]
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "options": {
                        "items": {
                          "$ref": "#/$defs/assetOption"
                        }
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
