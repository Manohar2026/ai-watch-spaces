# Copy to .env (git-ignored) and replace every placeholder. Never commit real values.
DB_NAME=aiws
DB_USERNAME=change-me
DB_PASSWORD=change-me
DB_POOL_SIZE=10
SERVER_PORT=8080

# Required (M2+). Base64 of at least 32 random bytes, e.g.: openssl rand -base64 32
# The placeholder below is deliberately invalid, so the app refuses to start until it is replaced.
JWT_SIGNING_KEY=change-me
JWT_ISSUER=ai-watch-spaces
ACCESS_TOKEN_TTL=15m
# Used from M4 onwards (invite codes).
INVITE_CODE_PEPPER=change-me
# Used once the AI module exists (OD-2).
LLM_API_KEY=change-me
